schemaVersion: provision.dev/v1alpha1
kind: Environment
name: lab
application: provision-example-http
rollbackWindow: 30m0s
targets:
  current:
    kind: host
    address: @ADDRESS@
    user: @OPERATOR@
implementations:
  web:
    kind: systemd
    target: current
    rollout: required
    endpoint:
      port: 18080
      drain:
        mode: bounded-http
        maxDuration: 2s
